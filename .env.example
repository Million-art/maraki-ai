# Telegram Bot Configuration
TOKEN=your_telegram_bot_token_here

# AI Configuration
GEMINI_API_KEY=your_gemini_api_key_here

# Database Configuration
MONGO_URI=mongodb://localhost:27017/maraki

# Redis Configuration
REDIS_URL_LOCAL=redis://localhost:6379
REDIS_URL=your_production_redis_url_here

# Server Configuration
PORT=3000
NODE_ENV=development

# Webhook Configuration (Production only)
WEBHOOK_URL=https://your-domain.com/webhook

# Admin Configuration
# Add your Telegram user ID here to access admin commands
# To find your Telegram ID, message @userinfobot on Telegram
ADMIN_ID=123456789
